# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values are exposed to the browser.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — bypasses RLS, never expose) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Idempotency token sealing (server only) ---
# 32 random bytes, base64. Example generator:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
IDEMPOTENCY_TOKEN_KEY=

# --- n8n notification webhook (server only) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Payment simulation gate (server) ---
# Must be "false" in production: /mock-gateway/* returns 404 when disabled.
MOCK_GATEWAY_ENABLED=false

# --- Public app URL, used to build capability links ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
