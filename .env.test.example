# Copy to .env.test (gitignored) before running `npm run test:int`.
# Fill the Supabase values from the LOCAL stack only:
#   npx supabase status -o env
# The integration suite refuses to run against a non-loopback URL.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Not exercised by the E-3 schema/RLS suite; only needed because src/lib/env.ts
# validates the whole server schema. Placeholder values are fine here.
IDEMPOTENCY_TOKEN_KEY=
N8N_WEBHOOK_URL=http://127.0.0.1:9999/webhook-test/roamly
N8N_WEBHOOK_SECRET=
MOCK_GATEWAY_ENABLED=true
